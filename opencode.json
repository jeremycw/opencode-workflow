{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/constitution.md"],
  "default_agent": "lead",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git branch -D*": "ask",
      "git clean -f*": "ask",
      "git push --force*": "ask",
      "rm -rf*": "ask",
      "npm publish*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "external_directory": {
      "~/.local/share/opencode/worktree/**": "allow"
    },
    "worktree_create": "allow",
    "worktree_apply": "allow",
    "worktree_delete": "allow",
    "worktree_list": "allow",
    "worktree_gc": "allow",
    "worktree_resolve_conflicts": "allow"
  }
}
